{
  "name": "advokatur-kanonengasse-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Verkaufs-Demo einer neuen Website für die advokatur kanonengasse, Zürich (Next.js, statischer Export, sechs Sprachen, Sanity vorbereitet)",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:pages",
    "build:pages": "npm run build:kern",
    "build:vercel": "cross-env DEPLOY_TARGET=vercel npm run build:kern",
    "build:kern": "npm run weiterleitungen && npm run inhalt:pruefen && npm run sitemap && npm run sanity:bilder && next build && node scripts/export-nachbereiten.mjs && npm run export:pruefen",
    "weiterleitungen": "node scripts/weiterleitungen.mjs",
    "sanity:bilder": "tsx scripts/sanity-bilder.mts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "bilder": "node scripts/bilder-optimieren.mjs",
    "inhalt:pruefen": "tsx --conditions=react-server scripts/inhalt-pruefen.mts",
    "pruefen": "npm run inhalt:pruefen && npm run lint && npm run typecheck && node werkzeuge/qa/kontrast.mjs",
    "export:pruefen": "node scripts/export-pruefen.mjs",
    "vorschau:pages": "node scripts/vorschau-server.mjs",
    "qa": "node werkzeuge/qa/audit.mjs && node werkzeuge/qa/funktionen.mjs",
    "seed": "tsx --conditions=react-server scripts/seed.mts",
    "sitemap": "tsx --conditions=react-server scripts/sitemap-schreiben.mts",
    "schriften": "node scripts/schriften-kopieren.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sanity/client": "^8.14.1",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
